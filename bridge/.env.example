# AgentRoom bridge — all env is OPTIONAL with safe defaults. The bridge reads/writes
# the local SQLite DB (@agentroom/db); there is no Supabase. Copy to .env to override.

# Where local app-data lives (must match the web app). Defaults to
# %APPDATA%\AgentRoom on Windows, otherwise ~/.agentroom.
AGENTROOM_HOME=
BRIDGE_WORKER_ID=bridge-local-1
BRIDGE_POLL_INTERVAL_MS=2000
BRIDGE_MAX_CONCURRENT_RUNS=3
BRIDGE_HEARTBEAT_INTERVAL_MS=5000
BRIDGE_STALE_RUN_TIMEOUT_MS=60000
# Liveness + metrics HTTP server port (GET /healthz, GET /metrics). 0 disables it.
# Bind to localhost / an internal network only — these endpoints are unauthenticated.
BRIDGE_HEALTH_PORT=9090
# Structured log level (debug | info | warn | error). Default: info.
LOG_LEVEL=info
# Optional error tracking. Opt-in — leave BOTH blank to disable (no network egress).
# See docs/OBSERVABILITY.md.
SENTRY_DSN=
ERROR_TRACKING_DSN=
# Paths to CLI binaries (override if not on PATH)
CLAUDE_BIN=claude
CODEX_BIN=codex
# Optional: third-party image text/OCR extraction (DATA EGRESS to OpenAI).
# OFF by default. To enable, set the flag to true AND provide an API key.
# When enabled, uploaded image bytes are sent to OpenAI's API.
# This key is read by the bridge itself and is NOT forwarded to spawned CLIs
# (it matches the *_KEY deny below). OPENAI_VISION_MODEL, being config rather than
# a credential, IS forwarded - see the BRIDGE_CHILD_ENV_ALLOW note.
ENABLE_IMAGE_TEXT_EXTRACTION=false
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Optional: extra env var names (comma-separated) to forward to agent CLI
# subprocesses. The child env is default-deny: a small base allowlist (PATH, HOME,
# TEMP, locale, ...) plus the names you list here.
#
# Names matching the secret pattern are stripped BEFORE this allowlist is read, so
# listing one here does nothing. The pattern is case-insensitive and denies a name
# that CONTAINS  SUPABASE  SERVICE_ROLE  SECRET  PASSWORD  CREDENTIAL  PRIVATE_KEY
# APIKEY, or that STARTS WITH  BRIDGE_, or that ENDS WITH  _TOKEN  _KEY, or that is
# exactly  TOKEN.
#
# WARNING - what IS forwarded to EVERY spawned CLI, without being listed here:
# any var starting with ANTHROPIC_ CLAUDE_CODE_ OPENAI_ CODEX_ AWS_ AZURE_ GOOGLE_
# GEMINI_ VERTEX_ that does not match the secret pattern above. That is provider
# CONFIG (e.g. ANTHROPIC_BASE_URL, AWS_REGION, OPENAI_VISION_MODEL above, and note
# AWS_ACCESS_KEY_ID, which is an identifier rather than a secret and matches no
# clause above). Every child sees it, including a CLI you connected yourself whose
# binary is any path on disk - so treat anything with those prefixes in this
# process's environment as visible to all of them.
#
# A per-agent provider key does NOT travel this way. It is stored encrypted, and
# injected into exactly one child env var for exactly one run (ADR-0010). A single
# connected CLI can also be given its own vars via that profile's `env` in
# config.json (see docs/CONNECTING_CLIS.md).
BRIDGE_CHILD_ENV_ALLOW=

# BYO provider credentials (ADR-0010). 32-byte key (64-hex or base64) used to decrypt
# user-stored API keys at spawn. Server-only — never the browser, never logged.
# Generate: `openssl rand -hex 32`. Leave blank to disable the BYO-credential feature.
CREDENTIAL_ENCRYPTION_KEY=
