{
  "name": "agentroom",
  "version": "1.7.0",
  "description": "A local, single-user chat room that puts the agent CLIs you already have installed (Claude Code, Codex, or your own) into one conversation as named participants. `npx agentroom` downloads the matching release source, builds it locally, and runs it — no hosted service, no accounts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neric-joel/Whatsapp-Agents.git"
  },
  "homepage": "https://github.com/neric-joel/Whatsapp-Agents#readme",
  "bugs": {
    "url": "https://github.com/neric-joel/Whatsapp-Agents/issues"
  },
  "keywords": [
    "agents",
    "multi-agent",
    "claude-code",
    "codex",
    "cli",
    "chat",
    "local-first",
    "sqlite"
  ],
  "bin": {
    "agentroom": "scripts/npx-bootstrap.mjs"
  },
  "files": [
    "scripts/npx-bootstrap.mjs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "start": "node scripts/launch.mjs",
    "prepublishOnly": "node --check scripts/npx-bootstrap.mjs",
    "build": "pnpm --filter web build",
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:bridge": "pnpm --filter bridge dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present run test && node --test scripts/test/npx-bootstrap.test.mjs",
    "test:coverage": "pnpm -r --if-present run test:coverage && node --test scripts/test/npx-bootstrap.test.mjs",
    "e2e": "playwright test",
    "e2e:list": "playwright test --list"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.9.0",
    "knip": "^6.31.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0"
  }
}
